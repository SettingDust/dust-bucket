{
    "version": "0.20.0",
    "description": "The command center that puts AI coding on steroids.",
    "homepage": "https://github.com/NeuralNomadsAI/CodeNomad",
    "license": "MIT",
    "depends": "opencode",
    "architecture": {
        "64bit": {
            "url": "https://github.com/NeuralNomadsAI/CodeNomad/releases/download/v0.20.0/CodeNomad-Tauri-windows-x64-0.20.0.zip",
            "hash": "e001f0f30f1c5a2f4aa80076861072f6dce5fbdb9b91d300cac6a29de56f3380"
        }
    },
    "extract_dir": "nsis",
    "pre_install": [
        "$installer = Get-ChildItem \"$dir\\nsis\" -Filter '*.exe' | Select-Object -First 1 -ExpandProperty FullName",
        "if (!$installer) { throw 'CodeNomad installer payload not found in extracted archive.' }",
        "7z x \"$installer\" \"-o$dir\" -y | Out-Null",
        "Remove-Item (Join-Path $dir '$PLUGINSDIR') -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item \"$dir\\uninstall.exe\" -Force -ErrorAction SilentlyContinue",
        "Remove-Item \"$dir\\nsis\" -Recurse -Force -ErrorAction SilentlyContinue"
    ],
    "bin": "codenomad-tauri.exe",
    "shortcuts": [
        [
            "codenomad-tauri.exe",
            "CodeNomad"
        ]
    ],
    "checkver": {
        "github": "https://github.com/NeuralNomadsAI/CodeNomad"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/NeuralNomadsAI/CodeNomad/releases/download/v$version/CodeNomad-Tauri-windows-x64-$version.zip"
            }
        }
    }
}
