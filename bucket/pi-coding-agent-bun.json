{
    "version": "0.85.0",
    "description": "Minimal terminal coding harness running on Bun",
    "homepage": "https://pi.dev",
    "license": "MIT",
    "depends": "bun",
    "url": [
        "https://github.com/earendil-works/pi/releases/download/v0.85.0/pi-coding-agent-install-package.json#/package.json",
        "https://github.com/earendil-works/pi/releases/download/v0.85.0/pi-coding-agent-install-package-lock.json#/package-lock.json"
    ],
    "hash": [
        "7cc7a12c408cc763f78609fe3a88544fc4dbc611460d73c97c1537ca3b557193",
        "83660283c1ce1676fae9b64fa87b406bc14d5ab033fbfec5b8601fafa9b05058"
    ],
    "installer": {
        "script": [
            "$cache = Join-Path $dir '.bun-cache'",
            "bun install --cwd $dir --cache-dir $cache --backend copyfile --production --ignore-scripts --frozen-lockfile",
            "$entry = Join-Path $dir 'node_modules\\@earendil-works\\pi-coding-agent\\dist\\cli.js'",
            "$tui = Join-Path $dir 'node_modules\\@earendil-works\\pi-tui\\dist\\index.js'",
            "if (!(Test-Path $entry -PathType Leaf) -or !(Test-Path $tui -PathType Leaf)) { throw 'Pi runtime files were not installed' }",
            "Set-Content $dir\\pi.cmd '@echo off', 'bun \"%~dp0node_modules\\@earendil-works\\pi-coding-agent\\dist\\cli.js\" %*'"
        ]
    },
    "bin": "pi.cmd",
    "checkver": {
        "github": "https://github.com/earendil-works/pi"
    },
    "autoupdate": {
        "url": [
            "https://github.com/earendil-works/pi/releases/download/v$version/pi-coding-agent-install-package.json#/package.json",
            "https://github.com/earendil-works/pi/releases/download/v$version/pi-coding-agent-install-package-lock.json#/package-lock.json"
        ]
    }
}
