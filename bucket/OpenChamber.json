{
    "version": "1.19.0",
    "description": "Desktop and web interface for OpenCode AI agent",
    "homepage": "https://github.com/openchamber/openchamber",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/openchamber/openchamber/releases/download/v1.19.0/OpenChamber-1.19.0-win-x64.exe#/dl.7z",
            "hash": "8ec7a027728741ef96eac7095b2bd220e30582d5c5c53ad6082c448df94a7508"
        }
    },
    "pre_install": [
        "$payload = Join-Path $dir '$PLUGINSDIR\\app-64.7z'",
        "if (!(Test-Path $payload)) { throw 'OpenChamber installer payload not found in extracted archive.' }",
        "7z x \"$payload\" \"-o$dir\" -y | Out-Null",
        "Remove-Item (Join-Path $dir '$PLUGINSDIR') -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item (Join-Path $dir '$R0') -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item (Join-Path $dir 'uninstallerIcon.ico') -Force -ErrorAction SilentlyContinue"
    ],
    "bin": "OpenChamber.exe",
    "shortcuts": [
        [
            "OpenChamber.exe",
            "OpenChamber"
        ]
    ],
    "checkver": {
        "github": "https://github.com/openchamber/openchamber"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/openchamber/openchamber/releases/download/v$version/OpenChamber-$version-win-x64.exe#/dl.7z"
            }
        }
    }
}
